        { "name": "POST Create Student", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Marie\",\n  \"lastName\": \"Dupont\",\n  \"email\": \"marie.dupont@email.com\",\n  \"city\": \"Paris\",\n  \"country\": \"France\",\n  \"latitude\": 48.8566,\n  \"longitude\": 2.3522\n}" }, "url": "{{baseUrl}}/api/students" },
        { "name": "PUT Update Student", "request": { "method": "PUT", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Marie\",\n  \"lastName\": \"Dupont\",\n  \"email\": \"marie.dupont@email.com\",\n  \"city\": \"Lyon\",\n  \"country\": \"France\",\n  \"latitude\": 45.764,\n  \"longitude\": 4.8357\n}" }, "url": "{{baseUrl}}/api/students/{{studentId}}" },
        { "name": "GET Student Points", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/students/{{studentId}}/points" },
        { "name": "DELETE Student", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/students/{{studentId}}" } }
      ]
    },
