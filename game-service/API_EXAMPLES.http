// ============================================================================
// GAMIFIED LEARNING PLATFORM - API REQUEST EXAMPLES
// ============================================================================
// This file contains example HTTP requests for all API endpoints
// Copy and paste into Postman, Insomnia, or your API client
// ============================================================================

// ============================================================================
// 1. HEALTH CHECK ENDPOINTS (No Auth Required)
// ============================================================================

### Health Check
GET http://localhost:8080/health

### Service Info
GET http://localhost:8080/health/info

// ============================================================================
// 2. GAME MANAGEMENT ENDPOINTS (No Auth Required)
// ============================================================================

### Get All Games
GET http://localhost:8080/api/games

### Get Games by Type (QUIZ)
GET http://localhost:8080/api/games?type=QUIZ

### Get Games by Type (MEMORY)
GET http://localhost:8080/api/games?type=MEMORY

### Get Games by Type (SENTENCE)
GET http://localhost:8080/api/games?type=SENTENCE

### Get Games by Difficulty (EASY)
GET http://localhost:8080/api/games?difficulty=EASY

### Get Games by Difficulty (MEDIUM)
GET http://localhost:8080/api/games?difficulty=MEDIUM

### Get Games by Difficulty (HARD)
GET http://localhost:8080/api/games?difficulty=HARD

### Get Specific Game
GET http://localhost:8080/api/games/1

// ============================================================================
// 3. GAME PLAY ENDPOINTS (Requires JWT Token)
// ============================================================================

### Get Game Content - Quiz (5 questions)
GET http://localhost:8080/api/games/1/play?limit=5
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_JWT_TOKEN_HERE

### Get Game Content - Memory (3 cards)
GET http://localhost:8080/api/games/3/play?limit=3
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_JWT_TOKEN_HERE

### Get Game Content - Sentence (5 questions)
GET http://localhost:8080/api/games/5/play?limit=5
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_JWT_TOKEN_HERE

// ============================================================================
// 4. SUBMIT GAME ANSWERS (Requires JWT Token)
// ============================================================================

### Submit Quiz Answers
POST http://localhost:8080/api/games/1/submit
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_JWT_TOKEN_HERE
Content-Type: application/json

{
  "answers": {
    "1": "Finding something good by chance",
    "2": "exhausted",
    "3": "A word with the same meaning",
    "4": "showing great attention to detail",
    "5": "to delay or postpone something"
  },
  "timeSpent": 120
}

### Submit Quiz Answers - Partial Correct
POST http://localhost:8080/api/games/1/submit
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_JWT_TOKEN_HERE
Content-Type: application/json

{
  "answers": {
    "1": "Feeling sad",
    "2": "exhausted",
    "3": "A word with opposite meaning",
    "4": "showing great attention to detail",
    "5": "to work hard"
  },
  "timeSpent": 150
}

### Submit Flashcard Answers
POST http://localhost:8080/api/games/3/submit
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_JWT_TOKEN_HERE
Content-Type: application/json

{
  "answers": {
    "1": "revealed",
    "2": "matched",
    "3": "revealed",
    "4": "matched",
    "5": "revealed"
  },
  "timeSpent": 90
}

### Submit Sentence Completion Answers
POST http://localhost:8080/api/games/5/submit
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_JWT_TOKEN_HERE
Content-Type: application/json

{
  "answers": {
    "1": "go",
    "2": "has",
    "3": "have",
    "4": "were",
    "5": "has gone"
  },
  "timeSpent": 180
}

### Submit Fill-in-the-Blanks Answers
POST http://localhost:8080/api/games/6/submit
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_JWT_TOKEN_HERE
Content-Type: application/json

{
  "answers": {
    "1": "nice",
    "2": "library",
    "3": "tell",
    "4": "delicious",
    "5": "happy"
  },
  "timeSpent": 210
}

// ============================================================================
// 5. USER PROGRESS ENDPOINTS (Requires JWT Token)
// ============================================================================

### Get User Progress for All Games
GET http://localhost:8080/api/progress
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_JWT_TOKEN_HERE

### Get User Statistics
GET http://localhost:8080/api/progress/stats
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_JWT_TOKEN_HERE

