// ============================================================
//  FRONTEND PIPELINE – Wordly Platform
//  Repo:     https://github.com/brouri12/angular-app.git
//  Registry: brouri12 (Docker Hub)
//  Stages:   Checkout → Install → Build → SonarQube
//            → Quality Gate → Docker Build & Push → Deploy to Kubernetes
// ============================================================
pipeline {
    agent any
    triggers {
        githubPush()
    }

    environment {
        REGISTRY    = 'brouri12'
        IMAGE_TAG   = "${env.BUILD_NUMBER}"
        SONAR_HOST  = 'http://wordly-sonarqube:9000'
        SONAR_TOKEN = credentials('sonar-token')
        GIT_REPO    = 'https://github.com/brouri12/angular-app.git'
    }

    stages {

        // ── 1. Checkout ──────────────────────────────────────────
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: "${GIT_REPO}",
                    credentialsId: 'github-credentials'
                sh '''
                    set -e
                    mkdir -p "$WORKSPACE/.ci" "$WORKSPACE/.cache"
                    NODE_VERSION="20.19.2"
                    NODE_DIR="$WORKSPACE/.cache/node-v${NODE_VERSION}-linux-x64"
                    NODE_BIN="$NODE_DIR/bin"
                    NODE_ARCHIVE="$WORKSPACE/.cache/node-v${NODE_VERSION}-linux-x64.tar.gz"

                    if [ ! -x "$NODE_BIN/node" ]; then
                      if [ ! -f "$NODE_ARCHIVE" ]; then
                        curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.gz" -o "$NODE_ARCHIVE"
                      fi
                      rm -rf "$NODE_DIR"
                      tar -xzf "$NODE_ARCHIVE" -C "$WORKSPACE/.cache"
                    fi

                    cat > "$WORKSPACE/.ci/npmw" <<'EOF'
#!/usr/bin/env sh
set -eu
NODE_BIN="$WORKSPACE/.cache/node-v20.19.2-linux-x64/bin"
export PATH="$NODE_BIN:$PATH"
exec npm "$@"
EOF
                    cat > "$WORKSPACE/.ci/npxw" <<'EOF'
#!/usr/bin/env sh
set -eu
NODE_BIN="$WORKSPACE/.cache/node-v20.19.2-linux-x64/bin"
export PATH="$NODE_BIN:$PATH"
exec npx "$@"
EOF
                    chmod +x "$WORKSPACE/.ci/npmw" "$WORKSPACE/.ci/npxw"
                    "$WORKSPACE/.ci/npmw" -v >/dev/null 2>&1
                '''
                echo "Branch: ${env.GIT_BRANCH} | Commit: ${env.GIT_COMMIT}"
            }
        }

        // ── 2. Install Dependencies (parallel) ───────────────────
        stage('Install Dependencies') {
            parallel {

                stage('Frontend – Install') {
                    steps {
                        dir('frontend/angular-app') {
                            sh '$WORKSPACE/.ci/npmw ci --legacy-peer-deps'
                        }
                    }
                }

                stage('Back Office – Install') {
                    steps {
                        dir('back-office') {
                            sh '$WORKSPACE/.ci/npmw ci --legacy-peer-deps'
                        }
                    }
                }

            }
        }

        // ── 3. Production Build (parallel) ───────────────────────
        stage('Build') {
            parallel {

                stage('Frontend – Build') {
                    steps {
                        dir('frontend/angular-app') {
                            sh '$WORKSPACE/.ci/npmw run build -- --configuration production'
                        }
                    }
                }

                stage('Back Office – Build') {
                    steps {
                        dir('back-office') {
                            sh '$WORKSPACE/.ci/npmw run build -- --configuration production'
                        }
                    }
                }

            }
        }

        // ── 4. SonarQube Analysis ─────────────────────────────────
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh """
                        cd frontend/angular-app && "$WORKSPACE/.ci/npxw" sonar-scanner \
                            -Dsonar.projectKey=wordly-frontend \
                            -Dsonar.projectName="Wordly Frontend" \
                            -Dsonar.sources=src \
                            -Dsonar.exclusions=**/node_modules/**,**/*.spec.ts,**/dist/** \
                            -Dsonar.host.url=${SONAR_HOST} \
                            -Dsonar.token=${SONAR_TOKEN}
                    """
                    sh """
                        cd back-office && "$WORKSPACE/.ci/npxw" sonar-scanner \
                            -Dsonar.projectKey=wordly-backoffice \
                            -Dsonar.projectName="Wordly Back Office" \
                            -Dsonar.sources=src \
                            -Dsonar.exclusions=**/node_modules/**,**/*.spec.ts,**/dist/** \
                            -Dsonar.host.url=${SONAR_HOST} \
                            -Dsonar.token=${SONAR_TOKEN}
                    """
                }
            }
        }

        // ── 5. Quality Gate ───────────────────────────────────────
        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: false
                }
            }
        }

        // ── 6. Docker Build & Push ────────────────────────────────
        stage('Docker Build & Push') {
            steps {
                script {
                    if (sh(returnStatus: true, script: 'command -v docker >/dev/null 2>&1') != 0) {
                        echo 'Docker Build & Push skipped: docker CLI not available on Jenkins agent.'
                        return
                    }
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'

                        sh """
                            docker build \
                                -t ${REGISTRY}/wordly-frontend:${IMAGE_TAG} \
                                -t ${REGISTRY}/wordly-frontend:latest \
                                ./frontend/angular-app
                            docker push ${REGISTRY}/wordly-frontend:${IMAGE_TAG}
                            docker push ${REGISTRY}/wordly-frontend:latest
                        """

                        sh """
                            docker build \
                                -t ${REGISTRY}/wordly-backoffice:${IMAGE_TAG} \
                                -t ${REGISTRY}/wordly-backoffice:latest \
                                ./back-office
                            docker push ${REGISTRY}/wordly-backoffice:${IMAGE_TAG}
                            docker push ${REGISTRY}/wordly-backoffice:latest
                        """
                    }
                }
            }
        }

        // ── 7. Deploy to Kubernetes ───────────────────────────────
        stage('Deploy to Kubernetes') {
            when {
                branch 'main'
            }
            steps {
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh 'kubectl apply -f devops/k8s/05-frontends.yml'
                    sh "kubectl set image deployment/frontend frontend=${REGISTRY}/wordly-frontend:${IMAGE_TAG} -n wordly"
                    sh "kubectl set image deployment/back-office back-office=${REGISTRY}/wordly-backoffice:${IMAGE_TAG} -n wordly"
                    sh 'kubectl rollout status deployment/frontend    -n wordly --timeout=120s'
                    sh 'kubectl rollout status deployment/back-office -n wordly --timeout=120s'
                }
            }
        }

    } // end stages

    post {
        always {
            archiveArtifacts allowEmptyArchive: true,
                             artifacts: 'frontend/angular-app/dist/**,back-office/dist/**'
            cleanWs()
        }
        success {
            echo "Frontend pipeline succeeded – build #${env.BUILD_NUMBER}"
        }
        failure {
            echo "Frontend pipeline failed – check logs above"
        }
    }
}
